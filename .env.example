# --- 서버 (런타임 환경변수) ---
PORT=3000
# 비워 두면 같은 출처(same-origin)의 WebSocket만 허용한다. 쉼표로 여러 개 지정할 수 있다.
ALLOWED_ORIGINS=
MAX_CONNECTIONS=200

# --- 빌드타임 (Vite) ---
# 발표자 비밀번호의 SHA-256(hex). 비워 두면 /presenter 는 "설정되지 않았습니다"만 보여 준다.
# 생성: printf '내비밀번호' | shasum -a 256 | cut -d' ' -f1
# Docker: docker build --build-arg VITE_PRESENTER_PASSWORD_SHA256=<해시> .
VITE_PRESENTER_PASSWORD_SHA256=
